root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Namespaces
csharp_style_namespace_declarations = file_scoped:warning

# var
csharp_style_var_when_type_is_apparent = true:suggestion

# Modern expression styles
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_prefer_braces = true:warning
csharp_style_prefer_primary_constructors = true:suggestion

# using directives
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# Prefer readonly / sealed
dotnet_style_readonly_field = true:warning

# CA1848 (LoggerMessage delegates) is followed in the API where logging is hot,
# but demanding it everywhere adds noise for a service this size.
dotnet_diagnostic.CA1848.severity = none
# The service is single-culture and speaks JSON; culture-aware overload nagging
# adds ceremony without changing behaviour.
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1310.severity = none
