<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- MediatR 13.0.0 relicensed from Apache-2.0 to a commercial licence.
         12.5.0 is the last Apache-2.0 release; the pin is exact, not a floor,
         so a restore can never silently cross that boundary. -->
    <PackageVersion Include="MediatR" Version="[12.5.0]" />

    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />

    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.30" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.30" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="8.0.30" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageVersion Include="Npgsql" Version="8.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="8.0.0" />

    <PackageVersion Include="Swashbuckle.AspNetCore" Version="8.1.4" />

    <!-- MIT, and MIT for every 8.x release to date - which is a fact about the past,
         not a guarantee, so this is pinned like the rest. Not bracketed: in this file a
         bracket means "a known licence cliff sits immediately above", and diluting that
         signal would cost more than it buys.
         Chosen over OpenTelemetry.Exporter.Prometheus.AspNetCore, which has never shipped
         a stable release - all 34 published versions are prerelease, the newest being
         1.18.0-beta.1 - and whose own README warns of breaking changes before stable.
         Accepted trade-off: the package targets net6.0, which net8.0 consumes without a
         warning, and its repository has had no commits since January 2024. -->
    <PackageVersion Include="prometheus-net.AspNetCore" Version="8.2.1" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />

    <!-- FluentAssertions 8.0.0 moved to a commercial Xceed licence.
         7.2.2 is the last Apache-2.0 release. Exact pin, same reason as MediatR. -->
    <PackageVersion Include="FluentAssertions" Version="[7.2.2]" />

    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.11" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="8.10.0" />
  </ItemGroup>

</Project>
